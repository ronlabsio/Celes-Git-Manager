{
  "name": "celes-monorepo-git",
  "displayName": "Celes - Git Manager",
  "description": "Git scoped to the package you are working on. A visual Git panel for VS Code, built for monorepos.",
  "version": "0.1.3",
  "publisher": "ronlabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ronlabsio/Celes-Git-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/ronlabsio/Celes-Git-Manager/issues"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "monorepo",
    "git",
    "scm",
    "source control",
    "workspace",
    "packages",
    "visual",
    "celes"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Celes runs the git executable against the opened repository, so it stays disabled until the workspace is trusted."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Celes – Git Manager",
      "properties": {
        "celes.gitPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the git executable. Leave empty to detect automatically. Machine-scoped: a workspace cannot override it, because this path is executed."
        },
        "celes.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "silent",
            "error",
            "info",
            "debug"
          ],
          "description": "Log level for the Celes output channel."
        },
        "celes.scope": {
          "type": "string",
          "default": "workspace",
          "enum": [
            "workspace",
            "repository"
          ],
          "enumDescriptions": [
            "Only show changes and commits for the opened folder. Use this in monorepos when you open a package subfolder.",
            "Show changes and commits for the entire Git repository, even when you open a subfolder."
          ],
          "description": "Which part of the repository Celes should display and operate on."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "celes",
          "title": "Celes – Git Manager",
          "icon": "resources/celes.svg"
        }
      ]
    },
    "views": {
      "celes": [
        {
          "id": "celesChanges",
          "name": "Changes",
          "type": "webview",
          "when": "celes:enabled"
        },
        {
          "id": "celesMore",
          "name": "More",
          "type": "webview",
          "when": "celes:enabled"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "celes.refresh",
          "when": "view == celesChanges",
          "group": "navigation"
        },
        {
          "command": "celes.openCommitPanel",
          "when": "view == celesChanges",
          "group": "navigation@1"
        },
        {
          "command": "celes.stageAll",
          "when": "view == celesChanges",
          "group": "navigation@2"
        },
        {
          "command": "celes.unstageAll",
          "when": "view == celesChanges",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "celes.initializeRepository",
          "when": "!celes:enabled"
        },
        {
          "command": "celes.stageFile",
          "when": "celes:enabled"
        },
        {
          "command": "celes.unstageFile",
          "when": "celes:enabled"
        },
        {
          "command": "celes.discardFile",
          "when": "celes:enabled"
        }
      ]
    },
    "commands": [
      {
        "command": "celes.open",
        "title": "Open",
        "category": "Celes"
      },
      {
        "command": "celes.refresh",
        "title": "Refresh",
        "category": "Celes",
        "icon": "$(refresh)"
      },
      {
        "command": "celes.toggleScope",
        "title": "Toggle Folder Scope (opened folder / whole repository)",
        "category": "Celes",
        "icon": "$(folder)"
      },
      {
        "command": "celes.initializeRepository",
        "title": "Initialize Repository",
        "category": "Celes"
      },
      {
        "command": "celes.fetch",
        "title": "Fetch",
        "category": "Celes"
      },
      {
        "command": "celes.pull",
        "title": "Pull",
        "category": "Celes"
      },
      {
        "command": "celes.push",
        "title": "Push",
        "category": "Celes"
      },
      {
        "command": "celes.publishBranch",
        "title": "Publish Branch",
        "category": "Celes"
      },
      {
        "command": "celes.commit",
        "title": "Commit",
        "category": "Celes",
        "icon": "$(check)"
      },
      {
        "command": "celes.openCommitPanel",
        "title": "Open Commit Panel",
        "category": "Celes",
        "icon": "$(git-commit)"
      },
      {
        "command": "celes.amendCommit",
        "title": "Amend Previous Commit",
        "category": "Celes"
      },
      {
        "command": "celes.stageFile",
        "title": "Stage",
        "category": "Celes",
        "icon": "$(plus)"
      },
      {
        "command": "celes.unstageFile",
        "title": "Unstage",
        "category": "Celes",
        "icon": "$(minus)"
      },
      {
        "command": "celes.stageAll",
        "title": "Stage All Changes",
        "category": "Celes",
        "icon": "$(plus)"
      },
      {
        "command": "celes.unstageAll",
        "title": "Unstage All Changes",
        "category": "Celes",
        "icon": "$(minus)"
      },
      {
        "command": "celes.discardFile",
        "title": "Discard Changes",
        "category": "Celes",
        "icon": "$(discard)"
      },
      {
        "command": "celes.openFile",
        "title": "Open File",
        "category": "Celes"
      },
      {
        "command": "celes.openDiff",
        "title": "Open Diff",
        "category": "Celes"
      },
      {
        "command": "celes.createBranch",
        "title": "Create Branch",
        "category": "Celes"
      },
      {
        "command": "celes.checkoutBranch",
        "title": "Checkout Branch",
        "category": "Celes"
      },
      {
        "command": "celes.renameBranch",
        "title": "Rename Branch",
        "category": "Celes"
      },
      {
        "command": "celes.deleteBranch",
        "title": "Delete Branch",
        "category": "Celes"
      },
      {
        "command": "celes.createStash",
        "title": "Create Stash",
        "category": "Celes"
      },
      {
        "command": "celes.applyStash",
        "title": "Apply Stash",
        "category": "Celes"
      },
      {
        "command": "celes.popStash",
        "title": "Pop Stash",
        "category": "Celes"
      },
      {
        "command": "celes.deleteStash",
        "title": "Delete Stash",
        "category": "Celes"
      },
      {
        "command": "celes.showCommitDetails",
        "title": "Show Commit Details",
        "category": "Celes"
      },
      {
        "command": "celes.renameCommit",
        "title": "Rename Commit",
        "category": "Celes"
      },
      {
        "command": "celes.undoCommit",
        "title": "Undo Commit (Keep Changes)",
        "category": "Celes"
      },
      {
        "command": "celes.showCommitDiff",
        "title": "Show Changes Side by Side",
        "category": "Celes"
      },
      {
        "command": "celes.openCommitFileDiff",
        "title": "Open Diff",
        "category": "Celes"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run lint",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:unit": "mocha --require source-map-support/register out/test/**/*.test.js",
    "test:unit:debug": "mocha --inspect-brk --require source-map-support/register out/test/**/*.test.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/sinon": "^17.0.3",
    "@types/vscode": "^1.84.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "mocha": "^10.2.0",
    "sinon": "^17.0.1",
    "source-map-support": "^0.5.21",
    "typescript": "^5.3.3"
  }
}
